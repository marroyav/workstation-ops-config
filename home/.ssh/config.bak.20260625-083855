Host lxtunnel.cern.ch
    HostName lxtunnel.cern.ch
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes
    ControlMaster auto 
    ControlPath /home/neutrino/.ssh/cm-%r@%h:%p
    ControlPersist 5h
    User marroyav
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes 


