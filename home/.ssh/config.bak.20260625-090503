# CERN SSH access
#
# lxtunnel is only the jump host. Do not delegate credentials here: the CERN
# lxtunnel GSS exchange accepts the ticket but delegation triggers
# "An invalid name was supplied" on some backend nodes.
Host lxtunnel lxtunnel.cern.ch cern-lxtunnel
    HostName lxtunnel.cern.ch
    User marroyav
    AddressFamily inet
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials no
    GSSAPITrustDNS yes
    PubkeyAuthentication yes
    ForwardAgent no
    ProxyJump none
    CheckHostIP no
    PreferredAuthentications gssapi-with-mic,keyboard-interactive,publickey
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 5h

