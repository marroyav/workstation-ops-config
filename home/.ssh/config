  IdentitiesOnly yes

# CERN SSH access.
#
# lxtunnel is the preferred jump host for NP04 routes. Credential delegation is
# intentionally disabled at the lxtunnel hop because it can fail on some backend
# nodes; delegation is enabled for lxplus and final NP04 hosts.
Host lxtunnel lxtunnel.cern.ch cern-lxtunnel
    HostName lxtunnel.cern.ch
    User marroyav
    AddressFamily inet
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials no
    GSSAPITrustDNS yes
    PubkeyAuthentication yes
    ForwardAgent no
    ProxyJump none
    CheckHostIP no
    PreferredAuthentications gssapi-with-mic,keyboard-interactive,publickey
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 5h

