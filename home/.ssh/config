# CERN stable SSH routes.
#
# Use lxplus as the login/jump host because it is the path that currently
# works reliably from this workstation. ControlMaster keeps the 2FA login alive
# and lets later connections reuse it.

Host lxplus lxplus.cern.ch lxplus*.cern.ch
    HostName lxplus.cern.ch
    User marroyav
    AddressFamily inet
    ProxyJump none
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    GSSAPITrustDNS yes
    PubkeyAuthentication no
    ForwardAgent yes
    CheckHostIP no
    PreferredAuthentications gssapi-with-mic,keyboard-interactive
    ServerAliveInterval 100
    ServerAliveCountMax 5
    TCPKeepAlive yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 5h

