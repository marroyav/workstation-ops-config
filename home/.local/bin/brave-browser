#!/bin/sh
set -eu

export GALLIUM_DRIVER=d3d12
export MESA_D3D12_DEFAULT_ADAPTER_NAME="${MESA_D3D12_DEFAULT_ADAPTER_NAME:-Intel}"

wayland_socket="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}/${WAYLAND_DISPLAY:-wayland-0}"
if [ -S "$wayland_socket" ]; then
  exec /usr/bin/brave-browser-stable --ozone-platform=wayland "$@"
fi

exec /usr/bin/brave-browser-stable "$@"
